# Required
ANTHROPIC_API_KEY=
NEATLOGS_API_KEY=

# Optional
# HAQ_VERIFY_MODEL=claude-sonnet-5-5   # eligibility verification
# HAQ_FAST_MODEL=claude-haiku-5-5      # interview, planning, summary
# HAQ_EFFORT=medium
# SIMULATE_FAILURE=1          # first official-page lookup fails on purpose (demo the recovery path)
# HAQ_STATE_FILE=data/state.json

# Public server (see deploy/README.md)
# HAQ_LIVE_PASSCODE=          # visitors need this for LIVE checks; without it a public server is demo-only
# HAQ_DAILY_BUDGET_USD=1.00   # hard daily cap on model spend (India date); default 1.00 when HAQ_PUBLIC=1
# HAQ_LIVE_RUNS_PER_HOUR=2    # live checks per visitor IP per hour
# HAQ_PUBLIC=1                # set by the systemd service on the server, not here
